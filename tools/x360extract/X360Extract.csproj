<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>x360extract</AssemblyName>
    <RootNamespace>X360Extract</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Description>CLI to extract default.xex and game content from Xbox 360 ISOs (GDFX + STFS)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reusable engine lives in lib\ and is consumed as a project reference.
         Exclude its sources so they are not compiled into the CLI a second time. -->
    <Compile Remove="lib\**\*.cs" />
    <ProjectReference Include="lib\X360Extract.Core.csproj" />
  </ItemGroup>

</Project>
